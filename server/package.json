{
  "name": "kreator-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts || tsx src/index.ts",
    "smoke-test": "tsc --noEmit",
    "lint": "eslint src",
    "test": "tsx --env-file=.env --test tests/**/*.test.ts",
    "test:apps": "tsx --env-file=.env --test tests/apps.test.ts",
    "test:key-messages": "tsx --env-file=.env --test tests/keyMessages.test.ts",
    "clean": "rm -rf meta && find . -maxdepth 1 -name '*_kreator.sql' -delete",
    "db:generate": "npm run clean && drizzle-kit generate --name=kreator && bash scripts/fix_create_table.sh"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@t3-oss/env-core": "^0.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.11.14",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@kovalee/core": "^1.0.0",
    "@trpc/server": "^11.1.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.2",
    "argon2": "^0.31.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.15.6",
    "superjson": "^2.2.2",
    "zod": "^3.24.3"
  }
}
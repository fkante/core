---
import Button from "../button/Button.astro";
---

<div class="m-auto max-w-screen-xl px-4 py-8 lg:px-6 lg:py-16">
  <div class="mx-auto max-w-screen-sm text-center">
    <h1
      class="text-primary mb-4 text-7xl font-extrabold tracking-tight lg:text-9xl"
    >
      404
    </h1>
    <p
      class="text-primary/50 mb-4 text-3xl font-bold tracking-tight text-gray-900 md:text-4xl"
    >
      Something's missing.
    </p>
    <p class="text-secondary/50 mb-4 text-lg">
      Sorry, we can't find that page. You'll find lots to explore on the home
      page.
    </p>
    <div class="mx-auto flex items-center justify-center">
      <Button size="md">
        <a href="/" class="text-white"> Back to Home </a>
      </Button>
    </div>
  </div>
</div>

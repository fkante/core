{
  "name": "@monorepo/root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "start:dev": "bash scripts/start.sh",
    "start:prod": "bash scripts/deploy.sh",
    "stop": "docker compose -f compose.yml down && docker compose -f compose.prod.yml down",
    "logs": "docker compose -f compose.yml logs -f || docker compose -f compose.prod.yml logs -f",
    "bootstrap": "docker compose -f compose.yml up -d --wait postgres && pnpm --filter backend db:migrate && pnpm --filter backend db:seed",
    "db:reset": "docker compose -f compose.yml exec -T -e PGPASSWORD=postgres postgres psql -U postgres -d app -c 'DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public; DROP SCHEMA IF EXISTS drizzle CASCADE;' && pnpm --filter backend db:migrate && pnpm --filter backend db:seed",
    "dev": "nx run-many -t dev --parallel=10",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:core": "pnpm --filter core dev",
    "build": "nx run-many -t build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "start:frontend": "pnpm --filter frontend start",
    "start:backend": "pnpm --filter backend start",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-compiler": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "nx": "^21.1.3",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.11.0"
  }
}
